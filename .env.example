SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
RESEND_API_KEY=re_your_key
BOOKING_EMAIL=booking@gladdy.de
# Optional: verified Resend sender. Falls back to onboarding@resend.dev for testing.
RESEND_FROM_EMAIL=GLADDY Party Crew <booking@gladdy.de>
NEXT_PUBLIC_SHOPIFY_DOMAIN=gladdy.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your-storefront-token

# Admin backend (required to use /admin)
ADMIN_PASSWORD=changeme
ADMIN_SESSION_TOKEN=generate-a-long-random-string-here

# Supabase service role key — bypasses RLS for admin operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe payments (optional — set to enable checkout)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal payments (optional)
PAYPAL_CLIENT_ID=your-client-id
PAYPAL_CLIENT_SECRET=your-client-secret
PAYPAL_MODE=sandbox
